```gitignore
# Dependencies
node_modules/

# Build output
dist/
build/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# SQLite database
*.sqlite
*.sqlite3
dev.sqlite3

# TypeScript
*.tsbuildinfo

# OS files
.DS_Store
Thumbs.db

# IDE / Editor
.vscode/
.idea/

# Coverage
coverage/

# Temporary files
tmp/
temp/

# Knex
migrations/*.js.map
seeds/*.js.map
```
